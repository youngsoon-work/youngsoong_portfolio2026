{
  "hosting": {
    "public": "project",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/",
        "destination": "/Home.html"
      },
      {
        "source": "/digital",
        "destination": "/digital/Home.html"
      }
    ]
  }
}
